# Supabase (production)
NEXT_PUBLIC_SUPABASE_URL=https://opanmigdltdwglklyrie.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional integrations (leave blank to disable)
OPENROUTER_API_KEY=
OPENROUTER_CONTENT_MODEL=
OPENROUTER_CONTENT_TIMEOUT_MS=45000
OPENROUTER_CONTENT_RETRIES=1
# Optional fallback: platform admins normally store the Stripe key from /admin/global/payments (Supabase Vault)
STRIPE_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM=
DEV_EMAIL_OUTBOX_PATH=

# Google Analytics 4. Defaults to WIAL's production property; loads only on production
# deploys. Set to "off" to disable, or NEXT_PUBLIC_GA_DEBUG=1 to load it locally and
# see events in GA DebugView.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-3W999NPQJY
NEXT_PUBLIC_GA_DEBUG=

# Search engines. The site is a staging copy of wial.org, so every page is served
# noindex (robots.txt Disallow, <meta robots>, X-Robots-Tag) until this is set to
# "true" on the production deploy after the domain cutover.
NEXT_PUBLIC_ALLOW_SEARCH_INDEXING=

# Newsletter sign-up (#164). Server-only secrets: never prefix with NEXT_PUBLIC_.
# Without them sign-ups are still saved to newsletter_signups (status "pending") and
# the visitor is told their email was saved, not that they are subscribed.
CONSTANT_CONTACT_LIST_ID=
# Either a static bearer token...
CONSTANT_CONTACT_ACCESS_TOKEN=
# ...or the OAuth2 refresh grant (CLIENT_SECRET optional for confidential apps).
CONSTANT_CONTACT_CLIENT_ID=
CONSTANT_CONTACT_CLIENT_SECRET=
CONSTANT_CONTACT_REFRESH_TOKEN=
# Override only for tests/mocks (defaults: https://api.cc.email/v3 and
# https://authz.constantcontact.com/oauth2/default/v1).
CONSTANT_CONTACT_API_BASE_URL=
CONSTANT_CONTACT_AUTH_BASE_URL=
